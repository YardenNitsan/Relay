{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true, "resolveJsonModule": true, "skipLibCheck": true,
    "noEmit": true, "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": ["shared", "server", "web", "tests", "*.ts", "scripts"]
}
