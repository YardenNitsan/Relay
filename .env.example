# Optional local-owner API credentials. Prefer Models & connections in Relay,
# which supports session-only credentials or the operating-system secret store.
# Never commit real credentials or share this file after adding keys.
# These variables are inherited by the host process; Relay does not automatically
# load .env files. Remote users must connect their own permitted API accounts.
# Consumer subscriptions and Google sign-in do not provide these API credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
